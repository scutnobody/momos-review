# Use a multimodal chat-completions endpoint. Keep this file's real copy local.
MOMOS_BASE_URL=https://openrouter.ai/api/v1
MOMOS_API_KEY=
MOMOS_SCORE_MODEL=
MOMOS_AGENT_MODEL=
# Optional independent overrides for the scoring service:
MOMOS_SCORE_BASE_URL=
MOMOS_SCORE_API_KEY=
# Optional independent overrides for explanation, audit and chat:
MOMOS_AGENT_BASE_URL=
MOMOS_AGENT_API_KEY=
# Optional localization service. Unset model/base use the Agent configuration.
MOMOS_LOCATOR_MODEL=
MOMOS_LOCATOR_BASE_URL=
MOMOS_LOCATOR_API_KEY=
# Optional dedicated review-chat service. Unset model/base use the Agent configuration.
MOMOS_CHAT_MODEL=
MOMOS_CHAT_BASE_URL=
MOMOS_CHAT_API_KEY=
MOMOS_PORT=4173
# Optional local paths:
# MOMOS_PYTHON=python
# MOMOS_REVIEW_DIR=.reviews
